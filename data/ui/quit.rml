<rml>
<head>
    <title>Quit</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<!-- The quit confirmation: over the port menu, or alone from the main menu's QUIT GAME. A (or OK)
     quits, B (or Back) goes back. -->
<body class="window">
    <div id="stage">
        <div id="scroll">
            <div class="part" id="paper"></div>
            <div class="part band" id="band-top"></div>
            <div class="part band" id="band-bottom"></div>
            <div class="part shade" id="shade-left"></div>
            <div class="part shade" id="shade-left-edge"></div>
            <div class="part shade" id="shade-right-edge"></div>
            <div class="part shade" id="shade-right"></div>
            <div class="part roller-body" id="roller-left-body"></div>
            <div class="part roller-top" id="roller-left-top"></div>
            <div class="part roller-bottom" id="roller-left-bottom"></div>
            <div class="part roller-body" id="roller-right-body"></div>
            <div class="part roller-top" id="roller-right-top"></div>
            <div class="part roller-bottom" id="roller-right-bottom"></div>
            <h1>Quit Game</h1>
            <p>Are you sure you want to quit? Progress since the last save will be lost.</p>
            <div class="answer" id="answer-back" data-action="back"><span class="button b"></span>Back</div>
            <div class="answer" id="answer-ok" data-action="quit" data-accept="data-accept">OK<span class="button a"></span></div>
        </div>
    </div>
</body>
</rml>
