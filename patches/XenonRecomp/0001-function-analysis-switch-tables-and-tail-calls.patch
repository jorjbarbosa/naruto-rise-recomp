+                        }
+                    }
                 }
 
                 RESTORE_DATA();
@@ -226,6 +250,12 @@ Function Function::Analyze(const void* code, size_t size, size_t base)
                 continue;
             }
 
+            // Inline jump tables put data between the bctr and the cases
+            if (blocks[i + 1].isSwitchCase)
+            {
+                continue;
+            }
