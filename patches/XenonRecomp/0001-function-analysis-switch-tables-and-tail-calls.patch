             {
                 blocks.emplace_back(branchDest - base, 0);
                 rBlock = blocks.size() - 1;
@@ -151,9 +158,9 @@ Function Function::Analyze(const void* code, size_t size, size_t base)
                     const size_t branchBase = branchDest - base;
