diff --git a/XenonRecomp/recompiler.cpp b/XenonRecomp/recompiler.cpp
index fa91527..f5eb7b1 100644
--- a/XenonRecomp/recompiler.cpp
+++ b/XenonRecomp/recompiler.cpp
@@ -193,6 +193,50 @@ void Recompiler::Analyse()
         }
     }
 
+    // Hints for Function::Analyze. Jump tables are keyed by the first instruction of
+    // their pattern in the config, the analyzer needs the address of their bctr.
+    std::unordered_map<size_t, std::vector<size_t>> switchTargets;
+    for (const auto& [tableBase, table] : config.switchTables)
+    {
+        for (size_t offset = 0; offset < 0x40; offset += 4)
+        {
+            auto* code = reinterpret_cast<const uint32_t*>(image.Find(tableBase + offset));
+            if (code == nullptr)
+                break;
+
+            if (ByteSwap(*code) == 0x4E800420) // bctr
+            {
+                switchTargets.emplace(tableBase + offset, std::vector<size_t>(table.labels.begin(), table.labels.end()));
+                break;
+            }
+        }
+    }
+
+    // Every entry point known before the analysis: helpers, configured functions,
+    // .pdata and all bl targets. A branch into one of them is a tail call.
+    std::unordered_set<size_t> functionStarts;
+    for (const auto& fn : functions)
+        functionStarts.emplace(fn.base);
+
+    for (const auto& section : image.sections)
+    {
+        if (!(section.flags & SectionFlags_Code))
+            continue;
+
+        for (size_t offset = 0; offset + 4 <= section.size; offset += 4)
+        {
+            uint32_t insn = ByteSwap(*(uint32_t*)(section.data + offset));
+            if (PPC_OP(insn) == PPC_OP_B && PPC_BL(insn) && !PPC_BA(insn))
+            {
+                size_t address = section.base + offset + PPC_BI(insn);
+                if (address >= section.base && address < section.base + section.size)
+                    functionStarts.emplace(address);
+            }
+        }
+    }
+
+    FunctionAnalyzeHints hints{ &switchTargets, &functionStarts };
+
     for (const auto& section : image.sections)
     {
         if (!(section.flags & SectionFlags_Code))
@@ -213,7 +257,7 @@ void Recompiler::Analyse()
                 if (address >= section.base && address < section.base + section.size && image.symbols.find(address) == image.symbols.end())
                 {
                     auto data = section.data + address - section.base;
