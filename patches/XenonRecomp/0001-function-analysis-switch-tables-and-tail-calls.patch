+        bool isSwitchCase{}; // reached through a jump table, may follow table data
         DEBUG(size_t parent{});
 
         Block() 
@@ -47,5 +63,5 @@ struct Function
     }
     
     size_t SearchBlock(size_t address) const;
-    static Function Analyze(const void* code, size_t size, size_t base);
+    static Function Analyze(const void* code, size_t size, size_t base, const FunctionAnalyzeHints* hints = nullptr);
