                     }
@@ -198,6 +205,23 @@ Function Function::Analyze(const void* code, size_t size, size_t base)
                             continue;
                         }
                     }
+                    else if (xop == 528 && hints != nullptr && hints->switchTargets != nullptr)
+                    {
+                        // bctr of a known jump table: every case belongs to this function
+                        auto switchTable = hints->switchTargets->find(addr);
+                        if (switchTable != hints->switchTargets->end())
+                        {
+                            for (size_t label : switchTable->second)
+                            {
+                                if (label < base || label >= base + size || fn.SearchBlock(label) != -1)
+                                    continue;
+
+                                blocks.emplace_back(label - base, 0).isSwitchCase = true;
+                                DEBUG(blocks.back().parent = blockBase);
