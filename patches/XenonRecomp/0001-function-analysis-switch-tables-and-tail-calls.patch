+Function Function::Analyze(const void* code, size_t size, size_t base, const FunctionAnalyzeHints* hints)
 {
     Function fn{ base, 0 };
 
+    // A branch to another known entry point leaves this function (tail call).
+    auto isOtherFunction = [&](size_t address)
+        {
