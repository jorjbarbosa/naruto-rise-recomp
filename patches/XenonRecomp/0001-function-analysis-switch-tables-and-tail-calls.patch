+// Optional knowledge the caller already has about the image.
+struct FunctionAnalyzeHints
+{
+    // Address of a bctr -> labels of its jump table. Without this, a bctr ends
+    // the function and the switch cases that follow it are left out.
+    const std::unordered_map<size_t, std::vector<size_t>>* switchTargets{};
+
+    // Known function entry points (.pdata, bl targets, configured functions).
+    // A branch to one of them is a tail call, so the analysis must not walk
+    // into that function.
+    const std::unordered_set<size_t>* functionStarts{};
+};
+
 struct Function
