+
+// The *_as_local options assume that a register kept as a local variable never carries a value
+// between functions. Three kinds of code break that:
+// - A funclet (the body of a __finally block or of an __except filter) that its parent calls
+//   directly. It is part of the parent's body: it receives the parent's frame in r12 and reads and
+//   writes the parent's non-volatile registers. The call is `addi r12, rN, frame` followed by `bl`.
+// - The register save/restore helpers, which read or write the caller's non-volatile registers.
+//   Functions with local registers do not call them, the ones found here still do.
+// - A function that calls setjmp: longjmp brings the registers back to their values at the setjmp,
+//   which the recompiled code does by restoring a copy of the context.
+// Those functions keep every register in the context, as without the options. Everything else
+// follows the calling convention and can be called from either kind.
+void Recompiler::FindContextRegisterFunctions()
+{
+    for (auto& fn : functions)
+    {
+        auto fnSymbol = image.symbols.find(fn.base);
+        if (fnSymbol != image.symbols.end() && fnSymbol->address == fn.base && IsRegisterHelper(fnSymbol->name))
+        {
+            contextRegisterFunctions.emplace(uint32_t(fn.base));
+            continue;
+        }
+
+        auto* data = (uint32_t*)image.Find(fn.base);
+        for (size_t i = 0; i < fn.size / 4; i++)
+        {
+            uint32_t insn = ByteSwap(data[i]);
+            if (PPC_OP(insn) != PPC_OP_B || !PPC_BL(insn) || PPC_BA(insn))
+                continue;
+
+            uint32_t target = uint32_t(fn.base + i * 4 + PPC_BI(insn));
+            if (config.setJmpAddress != 0 && target == config.setJmpAddress)
+            {
+                contextRegisterFunctions.emplace(uint32_t(fn.base));
+                continue;
+            }
+
+            // addi r12, rN, simm with N != 0 (N == 0 is li) right before the call.
+            uint32_t previous = i != 0 ? ByteSwap(data[i - 1]) : 0;
+            if (PPC_OP(previous) != PPC_OP_ADDI || ((previous >> 21) & 0x1F) != 12 || ((previous >> 16) & 0x1F) == 0)
+                continue;
+
+            auto symbol = image.symbols.find(target);
+            if (symbol == image.symbols.end() || symbol->address != target || symbol->type != Symbol_Function ||
+                IsRegisterHelper(symbol->name))
+            {
+                continue;
+            }
+
+            contextRegisterFunctions.emplace(target);
+            contextRegisterFunctions.emplace(uint32_t(fn.base));
+        }
+    }
 }
 
