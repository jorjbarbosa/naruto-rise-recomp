+// The register save/restore helpers (__savegprlr_14, __restfpr_14...), whatever the module suffix.
+static bool IsRegisterHelper(const std::string& name)
+{
+    return name.find("__rest") == 0 || name.find("__save") == 0;
+}
+
+// While alive, the *_as_local options are off when asked, so that a function is recompiled with every
+// register in the context.
+struct ContextRegistersScope
+{
+    RecompilerConfig& config;
+    const bool ctr;
+    const bool xer;
+    const bool reserved;
+    const bool cr;
+    const bool nonArgument;
+    const bool nonVolatile;
+
+    ContextRegistersScope(RecompilerConfig& config, bool contextRegisters)
+        : config(config), ctr(config.ctrAsLocalVariable), xer(config.xerAsLocalVariable),
+        reserved(config.reservedRegisterAsLocalVariable), cr(config.crRegistersAsLocalVariables),
+        nonArgument(config.nonArgumentRegistersAsLocalVariables), nonVolatile(config.nonVolatileRegistersAsLocalVariables)
+    {
+        if (contextRegisters)
+        {
+            config.ctrAsLocalVariable = false;
+            config.xerAsLocalVariable = false;
+            config.reservedRegisterAsLocalVariable = false;
+            config.crRegistersAsLocalVariables = false;
+            config.nonArgumentRegistersAsLocalVariables = false;
+            config.nonVolatileRegistersAsLocalVariables = false;
+        }
+    }
+
+    ~ContextRegistersScope()
+    {
+        config.ctrAsLocalVariable = ctr;
+        config.xerAsLocalVariable = xer;
+        config.reservedRegisterAsLocalVariable = reserved;
+        config.crRegistersAsLocalVariables = cr;
+        config.nonArgumentRegistersAsLocalVariables = nonArgument;
+        config.nonVolatileRegistersAsLocalVariables = nonVolatile;
+    }
+};
