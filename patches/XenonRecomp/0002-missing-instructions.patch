+inline simde__m128i simde_mm_vctuxs(simde__m128 src1)
+{
+    // NaN and values below 1 give 0, values at or above 2^32 saturate, the rest truncate
+    alignas(16) float in[4];
+    alignas(16) uint32_t out[4];
+    simde_mm_store_ps(in, src1);
+    for (size_t i = 0; i < 4; i++)
+    {
+        if (!(in[i] > 0.0f))
+            out[i] = 0;
+        else if (in[i] >= 4294967296.0f)
+            out[i] = UINT_MAX;
+        else
+            out[i] = uint32_t(in[i]);
+    }
+    return simde_mm_load_si128((simde__m128i*)out);
+}
+
+// Xbox 360 half floats, converted like the XDK reference code (xmconvert.inl):
+// exponent 31 is a regular number (no inf/NaN), float -> half saturates to 0x7FFF
+// and rounds to nearest even.
+inline float ppcHalfToFloat(uint16_t value)
+{
+    uint32_t mantissa = value & 0x3FF;
+    uint32_t exponent;
+
+    if ((value & 0x7C00) != 0)
+    {
+        exponent = (value >> 10) & 0x1F;
+    }
+    else if (mantissa != 0)
+    {
+        exponent = 1;
+        do
+        {
+            exponent--;
+            mantissa <<= 1;
+        } while ((mantissa & 0x400) == 0);
+        mantissa &= 0x3FF;
+    }
+    else
+    {
+        exponent = uint32_t(-112);
+    }
+
+    uint32_t result = ((value & 0x8000u) << 16) | ((exponent + 112) << 23) | (mantissa << 13);
+    float f;
+    memcpy(&f, &result, sizeof(f));
+    return f;
+}
+
+inline uint16_t ppcFloatToHalf(float value)
+{
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    uint32_t iValue = bits & 0x7FFFFFFF;
+    uint32_t sign = (bits & 0x80000000) >> 16;
+
+    if (iValue > 0x47FFEFFF)
+        return uint16_t(sign | 0x7FFF);
+
+    if (iValue < 0x38800000)
+    {
+        uint32_t shift = 113 - (iValue >> 23);
+        iValue = shift < 32 ? ((0x800000 | (iValue & 0x7FFFFF)) >> shift) : 0;
+    }
+    else
+    {
+        iValue += 0xC8000000;
+    }
+
+    return uint16_t(sign | ((iValue + 0x0FFF + ((iValue >> 13) & 1)) >> 13));
+}
