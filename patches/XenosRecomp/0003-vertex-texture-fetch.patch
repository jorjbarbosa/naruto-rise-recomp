+// 1D textures are bound as 2D textures one texel high. The game only fetches them in vertex
+// shaders (bone matrices, with UseComputedLOD=false), so the base level is sampled.
+float4 tfetch1D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float texCoord, float offset)
+{
+    Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
+    float2 coord = float2(texCoord + offset / getTexture2DDimensions(texture).x, 0.5);
+    return texture.SampleLevel(g_SamplerDescriptorHeap[samplerDescriptorIndex], coord, 0);
+}
