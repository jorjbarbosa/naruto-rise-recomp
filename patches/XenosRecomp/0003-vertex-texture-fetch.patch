+// Descriptor slots in the shared constants are indexed by texture fetch constant, one slot per
+// fetch constant for each dimension and for the sampler (the layout is in shader_common.h).
+static constexpr uint32_t FETCH_CONSTANT_COUNT = 32;
+
+// Texture fetch constant of a sampler register: pixel shader samplers use fetch constants 0-15,
+// vertex shader samplers (D3DVERTEXTEXTURESAMPLER0-3) use 16-19.
+static uint32_t fetchConstantIndex(bool isPixelShader, uint32_t samplerRegister)
+{
+    return isPixelShader ? samplerRegister : samplerRegister + 16;
+}
