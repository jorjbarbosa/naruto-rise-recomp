+// getGradients: the screen-space derivatives of the first two source components,
+// (dS/dX, dS/dY, dT/dX, dT/dY). No texture is read. The order follows the game: fwidth(x) compiles
+// to "getGradients r2._xy_, r2.xx" followed by |r2.y| + |r2.z|.
+void ShaderRecompiler::recompileGradients(const TextureFetchInstruction& instr)
+{
+    if (instr.isPredicated)
+    {
+        indent();
+        println("if ({}p0)", instr.predCondition ? "" : "!");
+
+        indent();
+        out += "{\n";
+        ++indentation;
+    }
+
+    indent();
+    print("r{}.", instr.dstRegister);
+    printDstSwizzle(instr.dstSwizzle, false);
+    print(" = getGradients(r{}.{}{}).", instr.srcRegister, SWIZZLES[instr.srcSwizzle & 0x3], SWIZZLES[(instr.srcSwizzle >> 2) & 0x3]);
+    printDstSwizzle(instr.dstSwizzle, true);
+    out += ";\n";
+
+    printDstSwizzle01(instr.dstRegister, instr.dstSwizzle);
+
+    if (instr.isPredicated)
+    {
+        --indentation;
+        indent();
+        out += "}\n";
+    }
+}
+
 void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicubic)
 {
+    if (instr.opcode == FetchOpcode::GetTextureGradients)
+    {
+        recompileGradients(instr);
+        return;
+    }
+
     if (instr.opcode != FetchOpcode::TextureFetch && instr.opcode != FetchOpcode::GetTextureWeights)
         return;
 
