new file mode 100644
--- /dev/null
+++ b/include/rex/input/sdl/device_identity.h
@@ -0,0 +1,19 @@
+#pragma once
+#include <SDL3/SDL.h>
+#include <rex/input/device.h>
+#include <string>
+namespace rex::input::sdl {
+inline std::string DeviceKey(SDL_Gamepad* pad) {
+  char guid[33]{};
+  SDL_GUIDToString(SDL_GetJoystickGUID(SDL_GetGamepadJoystick(pad)), guid, sizeof(guid));
+  const char* serial = SDL_GetGamepadSerial(pad);
+  const char* path = SDL_GetGamepadPath(pad);
+  if (serial && *serial)
+    return std::string("sdl:serial:") + guid + ":" + serial +
+           (path && *path ? std::string(":path:") + path : "");
+  if (path && *path)
+    return std::string("sdl:path:") + guid + ":" + path;
+  // Never let an ID reused by a later process impersonate saved hardware.
+  return "sdl:session:" + DeviceSessionToken() + ":" + std::to_string(SDL_GetGamepadID(pad));
+}
+}  // namespace rex::input::sdl
