+  const uint32_t client_callback_arg = clients_[index].wrapped_callback_arg;
+  global_lock.unlock();
+  if (!client_callback) {
+    return;
+  }
+
+  // One callback per period. With the driver's queue known, none while the
+  // queue covers the device's largest block plus the frames to keep ahead,
+  // and two while it runs low (the device clock may be slightly faster).
