 static int content_device_id_ = 0;
 
+// A title may name a package in another case than the one it was created with
+// (it creates "PlayerSave1.ninjasave" and opens "playersave1.ninjasave"). A
+// case-insensitive host file system hides that; elsewhere, use the existing
+// entry whose name matches ignoring case.
+static std::filesystem::path MatchExistingCase(const std::filesystem::path& path) {
+  std::error_code ec;
+  if (std::filesystem::exists(path, ec)) {
+    return path;
+  }
+  const std::string name = rex::path_to_utf8(path.filename());
+  std::filesystem::directory_iterator it(path.parent_path(), ec);
+  for (; !ec && it != std::filesystem::directory_iterator(); it.increment(ec)) {
+    if (rex::string::utf8_equal_case(rex::path_to_utf8(it->path().filename()), name)) {
+      return it->path();
+    }
+  }
+  return path;
+}
