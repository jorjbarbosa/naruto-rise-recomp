+namespace {
+// Sequence numbers correlate events across threads; they do not serialize heap operations.
+std::atomic<uint64_t> physical_memory_event{0};
+
+void TracePhysicalMemory(const char* operation, uint32_t address, uint32_t physical_address,
+                         uint32_t size, uint32_t heap_base, bool success) {
+  auto* thread = XThread::GetCurrentThread();
+  auto* context = thread ? thread->thread_state()->context() : nullptr;
+  REXKRNL_INFO(
+      "[PhysicalMemory] event={} op={} addr={:08X} physical={:08X} size={:X} "
+      "heap={:08X} success={} guest_thread={:X} guest_lr={:08X} guest_sp={:08X}",
+      physical_memory_event.fetch_add(1, std::memory_order_relaxed), operation, address,
+      physical_address, size, heap_base, success, thread ? thread->thread_id() : 0,
+      context ? uint32_t(context->lr) : 0, context ? context->r1.u32 : 0);
+}
+}  // namespace
