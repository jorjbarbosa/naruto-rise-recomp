diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index 19874a5..8c49309 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -1984,6 +1984,13 @@ void D3D12CommandProcessor::IssueSwap(uint32_t frontbuffer_ptr, uint32_t frontbu
   kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
   uint32_t display_width = std::max(uint32_t(1), uint32_t(video_mode.display_width));
   uint32_t display_height = std::max(uint32_t(1), uint32_t(video_mode.display_height));
+  // Ultrawide: o guest renderiza anamorfico para o aspecto alvo, entao o
+  // presenter recebe esse aspecto (so no host; VdQueryVideoMode fica intacto).
+  const double target_aspect = rex::cvar::Query<double>("ultrawide_target_aspect");
+  if (target_aspect > 0.0) {
+    display_height = 720;
+    display_width = uint32_t(std::clamp(target_aspect * 720.0, 1.0, 16384.0));
+  }
 
   presenter->RefreshGuestOutput(
       guest_output_width, guest_output_height, display_width, display_height,
