/* F0 v7, centered on a 720 dp canvas. Only the locally loaded logo is game
   artwork. The background is procedural, not a bundled image. */
body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #080f1b; }
#background { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
body.controls-open #identity, body.controls-open #choose-hint,
body.controls-open #menu, body.controls-open #status, body.controls-open #footer { opacity: 0; }
#identity { position: absolute; left: 50%; margin-left: -240dp; top: 96dp; width: 480dp; height: 192dp; }
#game-logo { position: absolute; left: 64dp; top: 0; width: 352dp; height: 192dp; }
#text-title { display: block; width: 100%; text-align: center; }
#title { display: block; margin-top: 24dp; font-size: 69.3dp; line-height: 85.3dp; font-weight: bold; letter-spacing: 0.7dp; color: #f5f2eb; }
#subtitle { display: block; margin-top: 0dp; font-size: 18dp; line-height: 28dp; letter-spacing: 3.3dp; color: #dadddd; }
#choose-hint { position: absolute; top: 256dp; left: 50%; margin-left: -300dp; width: 600dp;
  font-family: "Roboto"; font-size: 16dp; line-height: 24dp; text-align: center; color: #acb9c9; }
#menu { position: absolute; top: 328dp; left: 50%; margin-left: -186.7dp; width: 373.4dp; }
.item { display: block; position: relative; height: 48dp; tab-index: auto; nav: vertical; focus: auto; }
#first { height: 50.7dp; margin-bottom: 4dp; }
.item .plate { position: absolute; left: 6.7dp; top: 0; width: 360dp; height: 100%;
  background-color: #f58a35; transform: skewX(-12deg); visibility: hidden; }
.item .label { position: relative; display: block; line-height: 48dp; text-align: center;
  font-size: 20dp; font-weight: 500; letter-spacing: 0.7dp; color: #d4dce3; }
#first .label { line-height: 50.7dp; font-size: 24dp; }
.item:focus .plate { visibility: visible; }
.item:focus .label { font-weight: bold; color: #101823; }
#status { position: absolute; top: 562dp; left: 50%; margin-left: -360dp; width: 720dp;
  font-family: "Roboto"; font-size: 14.7dp; line-height: 22dp; text-align: center; color: #afbfc9; }
#status .dot { display: inline-block; width: 5.3dp; height: 5.3dp; margin-right: 8dp; vertical-align: middle;
  border-radius: 3dp; background-color: #74c99f; }
#status.warning { color: #aab7c5; }
#status.warning .dot { display: none; }
#status .detail { display: block; margin-top: 4dp; font-size: 14dp; line-height: 20dp; color: #c3b190; }
#footer { position: absolute; left: 6.25%; right: 6.25%; top: 645.3dp; height: 50dp;
  border-top: 1dp #263142; font-family: "Roboto"; }
#setup-hints { position: absolute; left: 0; top: 18dp; font-size: 14.7dp; color: #c5d1dd; white-space: pre; }
#version { position: absolute; right: 0; top: 21.3dp; font-size: 13.3dp; letter-spacing: 0.7dp; color: #aab7c5; }
