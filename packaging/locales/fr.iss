; Compatibility bridge messages for french.
french.ConfigReadFailed=Impossible de lire la configuration : %1
french.ConfigWriteFailed=Impossible d'écrire la configuration : %1
french.ActionTitle=Installer ou mettre à jour
french.ActionDescription=Choisissez comment installer la version {#MyAppVersion}.
french.ActionHint=La mise à jour conserve vos fichiers du jeu, paramètres, sauvegardes et DLC. Fermez le jeu et le lanceur avant de continuer.
french.UpdateOption=Mettre à jour une installation existante
french.InstallOption=Installer une nouvelle copie
french.UpdateFolderTitle=Sélectionner l'installation existante
french.UpdateFolderDescription=Sélectionnez le dossier contenant narutorise.exe et rexruntime.dll.
french.UpdateFolderHint=Les fichiers du portage PC seront mis à jour dans ce dossier. Vous n'avez pas besoin de réimporter votre ISO.
french.UpdateMissing=Aucune installation existante trouvée dans ce dossier. Sélectionnez le dossier contenant narutorise.exe et rexruntime.dll, ou choisissez une nouvelle installation.
french.UpdateSummary=Mettre à jour l'installation existante : %1 -> %2
french.VersionUnknown=version inconnue
french.VersionNewer=Ce dossier contient la version %1, plus récente que %2. Utilisez un installateur plus récent pour la mettre à jour.
french.VersionWriteFailed=Impossible d'écrire la version installée : %1
french.InvalidMode=Mode d'installation invalide. Utilisez /MODE=update ou /MODE=install.
french.UpdateFinishedTitle=Mise à jour terminée
french.UpdateFinished=La version %1 a été installée. Vos fichiers du jeu, paramètres, sauvegardes et DLC ont été conservés.
