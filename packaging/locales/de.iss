; Compatibility bridge messages for german.
german.ConfigReadFailed=Konfiguration konnte nicht gelesen werden: %1
german.ConfigWriteFailed=Konfiguration konnte nicht gespeichert werden: %1
german.ActionTitle=Installieren oder aktualisieren
german.ActionDescription=Wähle, wie Version {#MyAppVersion} installiert werden soll.
german.ActionHint=Updates erhalten Spieldateien, Einstellungen, Spielstände und DLCs. Schließe das Spiel und den Launcher, bevor du fortfährst.
german.UpdateOption=Vorhandene Installation aktualisieren
german.InstallOption=Neue Kopie installieren
german.UpdateFolderTitle=Vorhandene Installation auswählen
german.UpdateFolderDescription=Wähle den Ordner mit narutorise.exe und rexruntime.dll.
german.UpdateFolderHint=Die Dateien der PC-Portierung werden in diesem Ordner aktualisiert. Deine ISO muss nicht erneut importiert werden.
german.UpdateMissing=In diesem Ordner wurde keine vorhandene Installation gefunden. Wähle den Ordner mit narutorise.exe und rexruntime.dll oder eine neue Installation.
german.UpdateSummary=Vorhandene Installation aktualisieren: %1 -> %2
german.VersionUnknown=unbekannte Version
german.VersionNewer=Dieser Ordner enthält Version %1, die neuer als %2 ist. Verwende zum Aktualisieren ein neueres Installationsprogramm.
german.VersionWriteFailed=Installierte Version konnte nicht gespeichert werden: %1
german.InvalidMode=Ungültiger Installationsmodus. Verwende /MODE=update oder /MODE=install.
german.UpdateFinishedTitle=Update abgeschlossen
german.UpdateFinished=Version %1 wurde installiert. Spieldateien, Einstellungen, Spielstände und DLCs wurden erhalten.
